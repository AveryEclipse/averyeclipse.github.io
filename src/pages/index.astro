---
import { d } from "../config";
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Site.astro';
import Box from '../components/CollapsibleBox.astro';
---

<Layout title="Home" icon="waving-hand" head="Hi there~!" desc=`You landed on ${d.shortname}'s personal website! ^w^` rfgif="../../img/rf/welcome.gif" rfwarning={true}>
      <div>Who I am:
        <ul class="list nobullet">
        <li>💻 <b>I am a tech nerd</b> who happens to know a thing or two about coding.</li>
        <li>📹 <b>I make videos</b> on YouTube about things I like and enjoy.</li>
        <li>💖 <b>Part-time</b> gamer and visual artist.</li>
        </ul>
        <br>
        <div><b>Pronouns:</b> {d.pronouns}</div>
        <div><b>Timezone:</b> UTC{d.timezone}</div>
      </div>
    <div class="grid">
    <Box title="Buttons!" icon="star-rounded">
      <div class="button8831">
      <a href="https://axeon-network.github.io"><img src="/img/8831/axeon2.png" title="Axeon Network"></a>
      <a href="https://wetdry.world/@clyron"><img src="/img/8831/wetdryworld.png" title="Wet-Dry World"></a>
      <a href="http://bsky.app/profile/did:plc:fqvzbqsjzjkl4o66rfp6cgk3"><img src="/img/8831/bluesky.gif" title="Bluesky"></a>
      <img src="/img/8831/gnu-linux.gif" title="Made on GNU/Linux">
      <a href="https://archlinux.org"><img src="/img/8831/archlinux.gif" title="Arch Linux"></a>
      <a href="https://code.visualstudio.com/"><img src="/img/8831/vscode.gif" title="Visual Studio Code"></a>
      <img src="/img/8831/ublockoriginnow.png" title="uBlock Origin Now">
      <img src="/img/8831/ieexplode.gif" title="Internet Exploder">
      <img src="/img/8831/saynotoweb3.gif" title="Say no to Web3">
      <img src="/img/8831/eyes.gif" title="Best viewed with EYES">
      <img src="/img/8831/valid-any.gif" title="Any Browser!">
      <a href="https://googleballs.com"><img src="/img/8831/googleballs.png" title="Google Balls!!"></a>
      <a href="https://nixie.starlightnet.work" class="rf--hidden"><img src="https://nixie.starlightnet.work/?fg=eeeeee&bg=111111&pixel=1" alt="view counter"></a>
      </div>
      <div>
         <div style="padding-top:10px; padding-bottom:10px;"><b>My buttons!</b></div>
         <img src="/img/8831/avery1.png" class="mybutton" data-copy=`&lt;a href="http://${d.domain}"&gt;&lt;img src="http://${d.domain}/img/8831/avery1.png"&gt;` style="cursor:pointer;">
         <img src="/img/8831/avery2.png" class="mybutton" data-copy=`&lt;a href="http://${d.domain}"&gt;&lt;img src="http://${d.domain}/img/8831/avery2.png"&gt;` style="cursor:pointer;">
         <div id="clicktocopy" class="rf--hidden"></div>
         </div>
         <script>
            const status = document.getElementById('clicktocopy');

            const copyInstructions = '<i>Click on one of the buttons to copy and paste the HTML code!</i>';
            status.innerHTML = copyInstructions;

            document.querySelectorAll('.mybutton').forEach(btn => {
              const element = btn as HTMLElement;
              element.addEventListener('click', () => {
             const text = element.dataset.copy;

            navigator.clipboard.writeText(text)
              .then(() => {
                status.innerHTML = '<b>Copied!</b>';
              setTimeout(() => {
               status.innerHTML = copyInstructions;
               }, 1000);
           });
         });
     });
     </script>
    </Box>
    <Box title="Webrings!" icon="planet-rounded">
      <div id="webring">
        <b><a href="https://fediring.net/">Fediring</a></b>
        <a class="button" href=`https://fediring.net/previous?host=${d.domain}` title="Previous Site">
          <Icon name="material-symbols:arrow-back-rounded" /><span id="link" class="mof--hidden">&lt;&#45;&#45;</span></a>
        <a class="button" href="https://fediring.net/random" title="Random Site">
          <Icon name="material-symbols:shuffle" /><span id="link" class="mof--hidden">Random</span></a>
        <a class="button" href=`https://fediring.net/next?host=${d.domain}` title="Next Site">
          <Icon name="material-symbols:arrow-forward-rounded" /><span id="link" class="mof--hidden">&#45;&#45;&gt;</span></a>
      </div>
    </Box>
    </div>
</Layout>
