---
import Layout from "../../layouts/Site.astro";
import Box from '../../components/Box.astro';

type BlogPost = {
  frontmatter: {
    title: string;
    date: string;
    desc: string;
    tags: string[];
  };
  url: string;
};

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 10;

  const posts = Object.values(import.meta.glob("../../pages/blog/*.md", { eager: true })) as BlogPost[];

  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: {
      page: String(i + 2),
    },
  }));
}

const posts = Object.values(import.meta.glob("../../pages/blog/*.md", { eager: true })) as BlogPost[];

posts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);

const POSTS_PER_PAGE = 10;

const currentPage = Number(Astro.params.page || 1);

const start = (currentPage - 1) * POSTS_PER_PAGE;

const paginatedPosts = posts.slice(
  start,
  start + POSTS_PER_PAGE
);

const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<Layout icon="stylus" title="Blog" desc="Where I yap about random things! <a href='../feed.xml'>Also available on RSS</a>">
  { paginatedPosts.map((post) => 
    <Box title={post.frontmatter.title} url={post.url}>
      <h5>{post.frontmatter.date}&nbsp;&nbsp;•&nbsp;&nbsp;<i>{post.frontmatter.desc || 'No description available'}</i></h5>
      <h5 class="tags">{post.frontmatter.tags && post.frontmatter.tags.map(tag => (<a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>))}</h5>
    </Box>
  )}
  { totalPages > 1 && (
    <center><div class="pagination">
      { Array.from({ length: totalPages }, (_: undefined, i: number) => {
        const page = i + 1;
        return (<a class="button" href={page === 1 ? "/blog" : `/blog/${page}`}>{i + 1}</a>)
      })}
    </div></center>
  )}
</Layout>