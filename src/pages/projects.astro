---
import Layout from '../layouts/Site.astro';
import Box from '../components/Box.astro';
---

<Layout icon="folder-rounded" title="Projects" desc="What I do!">
   <Box
      icon="simple-icons:youtube"
      title="AstroNT"
      url="https://youtube.com/@astrontworkstation"
      desc="A tech-oriented YouTube channel with over 1K subs and growing!"
   />
   <Box 
      icon="material-symbols:book-ribbon-rounded"
      title="KuroWiki"
      url="https://axeon-network.github.io/kurowiki"
      desc="A wiki about the Axeon Network and some of its admins based on an custom engine, Akane. Project under the Axeon Network umbrella."
   />
   <Box 
      icon="material-symbols:photo-rounded"
      title="AnythingScreensaver"
      url="/anythingscreensaver"
      desc="Like one of those DVD screensavers, except the image can be anything you want."
   />
   <Box 
      icon="material-symbols:preview-outline"
      title="Previewer"
      url="/previewer"
      desc="A little utility for previewing HTML and/or CSS code."
   />
   <Box 
      icon="material-symbols:globe"
      title="AveryWebsite"
      desc="This website!"
   />
</Layout>