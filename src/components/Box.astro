---
import { cfg } from "../config";
import { Icon } from 'astro-icon/components';
interface Props {
  header?: boolean;
	title?: string;
  icon?: string;
}
const { header, title = false, icon = false } = Astro.props;
---
<div>
  <div class="box">
    { header && (
    <h2 class="section">
      { icon && (
        <Icon name=`${cfg.iconset}:${icon}` />
      )}
      { title && (
        <span>{title}</span>
      )}
    </h2>
    )}
    <slot />
   </div>
</div>