---
import { Icon } from 'astro-icon/components';
interface Props {
  header?: boolean;
	title?: string;
  icon?: string;
  url?: string;
  desc?: string;
}
const { header = true, title = false, icon = false, url, desc = false } = Astro.props;
---

<a href={url} style="text-decoration:none;">
  <div class="box" id={url ? "card" : undefined}>
    { header && (
      <h3>
        { icon && (<Icon name={icon} />)}
        { title && (title)}
      </h3>
      <h5>
        { desc && (<i>{desc}</i>)}
      </h5>
    )}
    <slot />
  </div>
</a>