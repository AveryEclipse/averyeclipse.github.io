---
import { cfg } from "../config";
import { Icon } from 'astro-icon/components';
interface Props {
	title: string;
  icon: string;
}
const { title, icon } = Astro.props;
---

<details class="cbox">
  <summary>
    <h2><Icon name=`${cfg.iconset}:${icon}` />{title}</h2>
  </summary> <!-- details and summary tags aren't supported on ancient browsers -->
  <div class="cboxcontent">
    <slot />
  </div>
</details>