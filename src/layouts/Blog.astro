---
const { frontmatter, headings } = Astro.props;
import { cfg } from "../config";

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:site_name" content=`${cfg.shortname}'s Blog!` />
    <meta property="og:image" content={cfg.favicon} />
    <meta name="title" content={frontmatter.title} />
    <meta name="description" content={frontmatter.desc} />
    <link rel="stylesheet" href="/css/style.rf.css" type="text/css">
    <link rel="stylesheet" href="/css/style.css" type="text/css">
    <link rel="icon" type="image/svg+xml" href={cfg.favicon} />
    <title>{frontmatter.title} ~ {cfg.name}</title>
  </head>
  <body>
    <Navbar />
      <div class="content blog">
        <div class="head blog">
          <h1 id="title">{frontmatter.title}</h1>
          <div>{frontmatter.date}&nbsp;&nbsp;•&nbsp;&nbsp;<i>{frontmatter.desc || 'No description available'}</i></div>
          <div>{frontmatter.tags && frontmatter.tags.map(tag => (<a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>))}</div>
        </div>
        <slot />
      </div>
      <Footer />
  </body>
</html>
