---
interface Props {
    icon: string;
    title: string;
    head?: string;
    desc: string;
}
const { icon, title, head, desc } = Astro.props;
const heading = head || title;
import { cfg } from "../config";
import { Icon } from 'astro-icon/components';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
    <head>

        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta property="og:site_name" content=`${cfg.shortname}'s Website!` />
        <meta property="og:image" content={cfg.favicon} />
        <meta name="title" content={title} />
        <meta name="description" content={desc} />
        <link rel="stylesheet" href="/css/style.rf.css" type="text/css" />
        <link rel="stylesheet" href="/css/style.css" type="text/css" />
        <link rel="icon" type="image/svg+xml" href={cfg.favicon} />
        <title>{title} ~ {cfg.name}</title>
    </head>
    <body>
        <Navbar />
         <div class="content">
            <div class="head">
                <h1 id="title">
                    <Icon name=`${cfg.iconset}:${icon}` />
                    {heading}
                </h1>
                <div set:html={desc}></div>
            </div>
        <slot />
        </div>
        <aside>
            <slot name="footer">
            <Footer />
            </slot>
        </aside>
    </body>
</html>