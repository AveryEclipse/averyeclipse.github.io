---
interface Props {
	title: string;
	head?: string;
	desc: string;
	rfgif?: string;
	showRssButton?: boolean;
	hideFooter?: boolean;
	rfwarning?: boolean;
}
const { title, head, desc, rfgif, showRssButton = false, hideFooter = false, rfwarning = false } = Astro.props;
const heading = head || title;
import { d } from "../config.ts";
import { Icon } from 'astro-icon/components';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta property="og:site_name" content=`${d.shortname}'s Website!` />
        <meta property="og:image" content=`${Astro.site}${d.favicon}`>
        <meta name="title" content={title} />
		<meta name="description" content={desc} />
		<link rel="icon" type="image/svg+xml" href=`${d.favicon}` />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="/css/style.rf.css" type="text/css">
        <link rel="stylesheet" href="/css/style.css" type="text/css">
		<title>{title} ~ {d.name}</title>
	</head>
	<body>
        <Navbar />
         <div class="content">
              <center><div class="mof--hidden gif"><img src={rfgif}></div></center>
			<div class="head">
			   <div>
               <h1 id="title">{heading}</h1>
               <div set:html={desc}></div>
			   </div>
			   <div>
				{ showRssButton && (
				<a class="button rf--hidden" href="../feed.xml" title="RSS Feed"><Icon name="material-symbols:rss-feed" /></a> 
				)}
			   </div>
            </div>
		<slot />
		{ rfwarning && (
		<div class="mof--hidden" style="margin-top: 20px;">
          <b>Warning!</b>&nbsp;Not all links to external webpages may work on ancient browsers.
        </div>
			)}
		</div>
		{ !hideFooter && (
		<Footer />
		)}
	</body>
</html>